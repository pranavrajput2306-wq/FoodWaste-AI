# Root .gitignore — AI-Powered Food Waste Prediction & Reduction System

# Environment files — NEVER commit
.env
.env.*
*.env
*.env.local
**/.env
**/.env.*

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# ML artefacts
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/data/raw/
ml/data/processed/

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
